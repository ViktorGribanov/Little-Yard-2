---
// Admin UI. Kept as an Astro page (not a public/ file) so that /admin/ resolves
// in the dev server too, not only in the built output.
// Config lives next to it: public/admin/config.yml → served as /admin/config.yml.
---

<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Little Yard — админка</title>
  </head>
  <body>
    <script is:inline src="https://unpkg.com/decap-cms@^3.6.0/dist/decap-cms.js"></script>

    <!--
      Мост авторизации. Окно /oauth/callback кладёт токен в localStorage этого же
      домена: после перехода через GitHub окно теряет связь с админкой, и обычное
      postMessage-рукопожатие Decap не срабатывает. Здесь мы забираем токен и
      доигрываем рукопожатие внутри страницы: сначала "authorizing:github",
      затем сообщение с токеном — ровно то, что ждёт Decap.
    -->
    <script is:inline>
      (function () {
        var KEY = 'little-yard-oauth';
        var MAX_AGE = 2 * 60 * 1000;

        function deliver(rawValue) {
          var data;
          try {
            data = JSON.parse(rawValue);
          } catch (e) {
            return;
          }
          if (!data || !data.token) return;
          if (Date.now() - Number(data.ts || 0) > MAX_AGE) return;

          var payload = JSON.stringify({ token: data.token, provider: 'github' });
          var message = 'authorization:github:success:' + payload;
          var origin = window.location.origin;

          // Decap слушает window и регистрирует обработчик токена только после
          // рукопожатия, поэтому пару «рукопожатие + токен» повторяем несколько раз.
          [0, 400, 1200, 2500].forEach(function (delay) {
            setTimeout(function () {
              window.postMessage('authorizing:github', origin);
              setTimeout(function () {
                window.postMessage(message, origin);
              }, 60);
            }, delay);
          });
        }

        window.addEventListener('storage', function (event) {
          if (event.key !== KEY || !event.newValue) return;
          try {
            localStorage.removeItem(KEY);
          } catch (e) {}
          deliver(event.newValue);
        });

        try {
          var pending = localStorage.getItem(KEY);
          if (pending) {
            localStorage.removeItem(KEY);
            deliver(pending);
          }
        } catch (e) {}
      })();
    </script>
  </body>
</html>
