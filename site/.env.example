# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# Публичный адрес сайта — из него строится ссылка на админку в уведомлении.
# Локально Telegram не делает кликабельными ссылки на localhost, поэтому
# сюда стоит вписать адрес после деплоя.
# SITE_URL=https://little-yard.pages.dev

# Telegram: токен от @BotFather и id чата/канала, куда приходят заявки.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Если провайдер блокирует api.telegram.org, укажите адрес своего прокси
# (например, Cloudflare Worker, который пересылает запросы в Telegram).
# TELEGRAM_API_BASE=https://ваш-worker.workers.dev

# Только для продакшена (Cloudflare Pages): коммит заявок в репозиторий.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main